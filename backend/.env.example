# FleetOps AI Backend Configuration
APP_ENV=development
APP_NAME=FleetOps AI
API_V1_PREFIX=/api/v1

# Database Configuration
# Local SQLite fallback (zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./fleetops.db

# Docker / Production PostgreSQL (separate compose stack):
# DATABASE_URL=postgresql+asyncpg://fleetops:fleetops_dev_password@localhost:5434/fleetops

# ChromaDB RAG Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional LLM Key (Offline deterministic mode enabled by default when empty)
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional Langfuse Observability Tracing (Graceful fallback when not configured)
LANGFUSE_PUBLIC_KEY=replace_with_your_public_key
LANGFUSE_SECRET_KEY=replace_with_your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
