# ==========================================
# FleetOps AI - Environment Configuration
# ==========================================

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_DB=fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=fleetops_dev_password
POSTGRES_PORT=5434

# Optional LLM Configuration
# If left blank, backend runs in deterministic offline evaluation mode
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4o-mini

# Optional Langfuse Observability
LANGFUSE_PUBLIC_KEY=replace_with_your_public_key
LANGFUSE_SECRET_KEY=replace_with_your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
